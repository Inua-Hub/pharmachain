                <div className="space-y-3">{medicines.filter(m => verified.includes(m.id)).slice(-5).reverse().map((med) => (<div key={med.id} className="flex items-center justify-between p-3 bg-gray-50 rounded-xl"><div><p className="font-medium text-gray-800">{med.name}</p><p className="text-xs text-gray-400">Batch: {med.batchNo}</p></div><div className="text-right"><p className="text-xs text-green-600">✓ Verified</p><p className="text-xs text-gray-400">{new Date().toLocaleDateString()}</p></div></div>))}</div>
              )}
            </div>
          </div>
        )}

        {/* DISPENSE MEDICINE - Pharmacy only */}
        {activeTab === "dispense" && user?.role === "pharmacy" && (
          <div className="space-y-6">
