            </div>
            {selectedMedicine && (<div className="bg-white rounded-2xl shadow-sm p-6"><h3 className="font-semibold mb-4">Patient Information</h3><div className="grid grid-cols-1 md:grid-cols-2 gap-4"><div><label className="block text-sm font-medium mb-1">Patient Name *</label><input type="text" placeholder="Full name" value={patientName} onChange={(e) => setPatientName(e.target.value)} className="w-full p-3 border rounded-xl" /></div><div><label className="block text-sm font-medium mb-1">Patient ID (Optional)</label><input type="text" placeholder="ID or Phone number" value={patientId} onChange={(e) => setPatientId(e.target.value)} className="w-full p-3 border rounded-xl" /></div></div><div className="mt-4 p-4 bg-gray-50 rounded-xl"><p><strong>Selected Medicine:</strong> {selectedMedicine.name}</p><p><strong>Price:</strong> {parseInt(selectedMedicine.price).toLocaleString()} TZS</p></div><button onClick={dispenseMedicine} className="mt-4 w-full bg-purple-600 text-white py-3 rounded-xl font-semibold">Confirm Dispense</button></div>)}
          </div>
        )}

        {/* INVENTORY - Manufacturer, Pharmacy, Distributor */}
        {(activeTab === "list" && (user?.role === "manufacturer" || user?.role === "pharmacy" || user?.role === "distributor")) && (
          <div className="bg-white rounded-2xl shadow-sm p-6">
            <div className="flex justify-between items-center mb-6 flex-wrap gap-4"><div><h2 className="text-xl font-bold">Inventory Management</h2><p className="text-gray-500 text-sm">{myMedicines.length} items in {user?.role === "pharmacy" ? "stock" : "system"}</p></div><div className="relative"><Search className="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400" /><input type="text" placeholder="Search..." value={searchTerm} onChange={(e) => setSearchTerm(e.target.value)} className="pl-10 pr-4 p-2 border rounded-lg w-64" /></div></div>
            <div className="overflow-x-auto"><table className="w-full text-sm"><thead className="bg-gray-50"><tr><th className="p-3 text-left">Medicine</th><th className="p-3 text-left">Batch</th><th className="p-3 text-left">Manufacturer</th><th className="p-3 text-left">Expiry</th><th className="p-3 text-left">Price</th><th className="p-3 text-left">Status</th>{user?.role === "pharmacy" && <th className="p-3 text-left">Action</th>}</tr></thead><tbody>{myMedicines.map((med) => (<tr key={med.id} className="border-t"><td className="p-3 font-medium">{med.name}</td><td className="p-3 text-gray-600">{med.batchNo}</td><td className="p-3 text-gray-600">{med.manufacturer}</td><td className={`p-3 ${getExpiryColor(med.expiryDate)}`}>{getExpiryStatus(med.expiryDate)}</td><td className="p-3">{parseInt(med.price).toLocaleString()} TZS</td><td className="p-3"><span className="px-2 py-1 rounded-full text-xs bg-green-100 text-green-700">{med.status}</span></td>{user?.role === "pharmacy" && med.status === "active" && (<td className="p-3"><button onClick={() => { setSelectedMedicine(med); setActiveTab("dispense"); }} className="px-3 py-1 bg-purple-600 text-white text-xs rounded-lg">Dispense</button></td>)}

              </tr>))}</tbody></table></div>
          </div>
        )}

        {/* PATIENT HISTORY */}
        {activeTab === "history" && user?.role === "patient" && (
          <div className="bg-white rounded-2xl shadow-sm p-6">
            <h2 className="text-xl font-bold mb-6">My Verified Medicines</h2>
            {verified.length === 0 ? (<div className="text-center py-12"><Scan className="w-16 h-16 text-gray-300 mx-auto mb-4" /><p className="text-gray-400">No medicines verified yet. Go to Verify Medicine to scan your first medicine.</p><button onClick={() => setActiveTab("scan")} className="mt-4 bg-green-600 text-white px-4 py-2 rounded-lg">Scan Now</button></div>) : (<div className="space-y-3">{medicines.filter(m => verified.includes(m.id)).map((med) => (<div key={med.id} className="flex justify-between items-center p-4 border rounded-xl"><div><p className="font-semibold">{med.name}</p><p className="text-xs text-gray-500">Batch: {med.batchNo} | Manufacturer: {med.manufacturer}</p></div><div className="text-right"><p className="text-sm text-green-600">✓ Verified</p><p className="text-xs text-gray-400">Expires: {med.expiryDate || "N/A"}</p></div></div>))}</div>)}
          </div>
        )}

        {/* ADMIN PANEL */}
        {activeTab === "admin" && user?.role === "admin" && (
          <div className="space-y-6">
            <div className="bg-gradient-to-r from-slate-800 to-slate-900 rounded-2xl p-6 text-white"><div className="flex items-center gap-2 mb-2"><Shield className="w-6 h-6 text-slate-400" /><span className="text-sm text-slate-400">Administrator Access</span></div><h2 className="text-2xl font-bold">System Control Panel</h2><p className="text-slate-400 text-sm">Manage members, payments, and system operations</p></div>
            <div className="grid grid-cols-2 md:grid-cols-4 gap-4"><div className="bg-white rounded-xl p-4 shadow-sm border-l-4 border-green-500"><p className="text-gray-500 text-sm">System Uptime</p><p className="text-2xl font-bold">99.95%</p></div><div className="bg-white rounded-xl p-4 shadow-sm border-l-4 border-blue-500"><p className="text-gray-500 text-sm">Total Members</p><p className="text-2xl font-bold">{adminStats.totalMembers}</p></div><div className="bg-white rounded-xl p-4 shadow-sm border-l-4 border-green-500"><p className="text-gray-500 text-sm">Revenue MTD</p><p className="text-2xl font-bold text-green-600">4,250,000 TZS</p></div><div className="bg-white rounded-xl p-4 shadow-sm border-l-4 border-yellow-500"><p className="text-gray-500 text-sm">Pending</p><p className="text-2xl font-bold text-yellow-600">1,500,000 TZS</p></div></div>
            <div className="grid grid-cols-2 gap-4"><button onClick={() => setShowNotifyModal(true)} className="bg-blue-600 text-white p-4 rounded-xl flex items-center justify-center gap-2"><Send className="w-5 h-5" />Broadcast Message</button><button className="bg-gray-800 text-white p-4 rounded-xl flex items-center justify-center gap-2"><RefreshCw className="w-5 h-5" />Sync Blockchain</button></div>
            <div className="bg-white rounded-xl shadow-sm overflow-hidden"><div className="p-4 bg-gray-50 border-b"><h3 className="font-semibold flex items-center gap-2"><Users className="w-5 h-5" />Member Management</h3></div><div className="overflow-x-auto"><table className="w-full text-sm"><thead className="bg-gray-50"><tr><th className="p-3 text-left">Name</th><th className="p-3 text-left">Email</th><th className="p-3 text-left">Role</th><th className="p-3 text-left">Plan</th><th className="p-3 text-left">Fee</th><th className="p-3 text-left">Status</th><th className="p-3 text-left">Actions</th></tr></thead><tbody>{regularMembers.map((m: any) => (<tr key={m.id} className="border-t"><td className="p-3 font-medium">{m.name}</td><td className="p-3 text-gray-600">{m.email}</td><td className="p-3 capitalize">{m.role}</td><td className="p-3">{getPlan(m.role)}</td><td className="p-3">{getAmount(m.role)} TZS</td><td className="p-3"><span className="px-2 py-1 rounded-full text-xs bg-green-100 text-green-700">Active</span></td><td className="p-3"><div className="flex gap-2"><button onClick={() => sendReminder(m)} className="p-1.5 bg-yellow-100 rounded-lg"><Bell className="w-4 h-4 text-yellow-700" /></button><button onClick={() => { setSelectedMember(m); setShowPaymentModal(true); }} className="p-1.5 bg-green-100 rounded-lg"><DollarSign className="w-4 h-4 text-green-700" /></button></div></td>

              </tr>))}</tbody></table></div></div>
            <div className="grid grid-cols-1 md:grid-cols-2 gap-5"><div className="bg-white rounded-xl p-5 shadow-sm"><h3 className="font-semibold mb-4 flex items-center gap-2"><Settings className="w-5 h-5" />System Maintenance</h3><div className="space-y-2"><button className="w-full flex justify-between p-3 border rounded-lg"><span>📦 Backup Database</span><span className="text-xs text-gray-400">Run now</span></button><button className="w-full flex justify-between p-3 border rounded-lg"><span>📊 Export Logs</span><span className="text-xs text-gray-400">30 days</span></button><button className="w-full flex justify-between p-3 border border-red-200 rounded-lg"><span>🗑️ Clear Cache</span><span className="text-xs text-red-500">Maintenance</span></button></div></div><div className="bg-white rounded-xl p-5 shadow-sm"><h3 className="font-semibold mb-4 flex items-center gap-2"><Activity className="w-5 h-5" />Recent Activity</h3><div className="space-y-2 text-sm"><div className="flex justify-between"><span>Backup completed</span><span className="text-xs text-gray-400">02:00 AM</span></div><div className="flex justify-between"><span>Blockchain synced</span><span className="text-xs text-gray-400">01:30 AM</span></div><div className="flex justify-between"><span>Reminders sent</span><span className="text-xs text-gray-400">Yesterday</span></div></div></div></div>
            <div className="bg-slate-50 rounded-xl p-4 text-center text-xs text-gray-500"><Shield className="w-3 h-3 inline mr-1" />Admin Mode • All actions logged</div>
          </div>
        )}

        {/* SETTINGS */}
        {activeTab === "settings" && (
          <div className="bg-white rounded-2xl shadow-sm p-8 max-w-2xl">
            <h2 className="text-2xl font-bold mb-6">Account Settings</h2>
            <div className="space-y-4"><div><label className="block font-medium mb-1">Full Name</label><input type="text" defaultValue={user?.name} className="w-full p-3 border rounded-xl" /></div><div><label className="block font-medium mb-1">Email</label><input type="email" defaultValue={user?.email} className="w-full p-3 border rounded-xl" /></div><div><label className="block font-medium mb-1">Phone</label><input type="tel" defaultValue={user?.phone} className="w-full p-3 border rounded-xl" /></div><button className="w-full bg-blue-600 text-white py-3 rounded-xl font-semibold">Save Changes</button></div>
          </div>
        )}

      </main>

      {/* Modals */}
      {showPaymentModal && selectedMember && (
        <div className="fixed inset-0 bg-black/50 flex items-center justify-center z-50"><div className="bg-white rounded-2xl p-6 w-96"><div className="flex justify-between mb-4"><h3 className="text-xl font-bold">Record Payment</h3><button onClick={() => setShowPaymentModal(false)}><X className="w-5 h-5" /></button></div><div className="space-y-3"><div className="bg-gray-50 p-3 rounded"><p className="text-sm text-gray-500">Member</p><p className="font-bold">{selectedMember.name}</p></div><div className="bg-gray-50 p-3 rounded"><p className="text-sm text-gray-500">Amount</p><p className="font-bold text-green-600">{getAmount(selectedMember.role)} TZS</p></div><input type="date" className="w-full p-2 border rounded" defaultValue={new Date().toISOString().split('T')[0]} /><div className="flex gap-3 pt-3"><button onClick={() => setShowPaymentModal(false)} className="flex-1 p-2 border rounded">Cancel</button><button onClick={markPaid} className="flex-1 p-2 bg-green-600 text-white rounded">Confirm</button></div></div></div></div>
      )}

      {showNotifyModal && (
        <div className="fixed inset-0 bg-black/50 flex items-center justify-center z-50"><div className="bg-white rounded-2xl p-6 w-96"><div className="flex justify-between mb-4"><h3 className="text-xl font-bold">Broadcast</h3><button onClick={() => setShowNotifyModal(false)}><X className="w-5 h-5" /></button></div><div className="space-y-3"><select className="w-full p-2 border rounded" value={notifyRole} onChange={(e) => setNotifyRole(e.target.value)}><option value="all">All Members</option><option value="manufacturer">Manufacturers</option><option value="distributor">Distributors</option><option value="pharmacy">Pharmacies</option><option value="patient">Patients</option></select><input type="text" placeholder="Subject" className="w-full p-2 border rounded" value={notifySubject} onChange={(e) => setNotifySubject(e.target.value)} /><textarea rows={3} placeholder="Message" className="w-full p-2 border rounded resize-none" value={notifyMessage} onChange={(e) => setNotifyMessage(e.target.value)} /><div className="flex gap-3 pt-3"><button onClick={() => setShowNotifyModal(false)} className="flex-1 p-2 border rounded">Cancel</button><button onClick={sendNotification} className="flex-1 p-2 bg-blue-600 text-white rounded">Send</button></div></div></div></div>
      )}
    </div>
  );
}