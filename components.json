              {activeTab === "scan" && "Verify Medicine"}
              {activeTab === "dispense" && "Dispense Medicine"}
              {activeTab === "list" && "Inventory Management"}
              {activeTab === "history" && "My Verification History"}
              {activeTab === "admin" && "Admin Panel"}
              {activeTab === "settings" && "Settings"}
