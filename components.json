          {user?.role === "pharmacy" && (
            <button onClick={() => { setActiveTab("dispense"); setSearchTerm(""); stopScanner(); }} className={`w-full flex items-center gap-3 px-3 py-2.5 rounded-xl transition-all ${activeTab === "dispense" ? "bg-white/10 text-white" : "text-white/60 hover:text-white hover:bg-white/5"}`}>
