                  <div className="bg-white rounded-2xl p-6 shadow-sm border-l-4 border-purple-500"><div className="flex justify-between"><div><p className="text-gray-500 text-sm">Dispensed Today</p><p className="text-3xl font-bold text-purple-600">{pharmacyStats.dispensedToday}</p></div><Clock className="w-8 h-8 text-purple-500" /></div></div>
                  <div className="bg-white rounded-2xl p-6 shadow-sm border-l-4 border-yellow-500"><div className="flex justify-between"><div><p className="text-gray-500 text-sm">Expiring Soon</p><p className="text-3xl font-bold text-yellow-600">{pharmacyStats.expiringSoon}</p></div><AlertCircle className="w-8 h-8 text-yellow-500" /></div></div>
                </div>
                <div className="bg-gradient-to-r from-purple-600 to-blue-600 rounded-2xl p-6 text-white"><div className="flex items-center gap-3 mb-3"><Store className="w-6 h-6" /><h3 className="text-xl font-bold">Pharmacy Dashboard</h3></div><p>Manage your inventory, dispense medicines to patients, and track stock levels.</p><button onClick={() => setActiveTab("dispense")} className="mt-4 bg-white text-purple-700 px-4 py-2 rounded-lg font-medium">Go to Dispense →</button></div>
              </div>
