                    Verify Now
                  </button>
                </div>
              </div>
            </div>
            
            {/* Verification Result */}
            {verifyResult && (
              <div className={`rounded-2xl p-8 ${verifyResult.success ? "bg-green-50 border border-green-200" : "bg-red-50 border border-red-200"} animate-in slide-in-from-top-2 duration-300`}>
