                  <div className="bg-white rounded-2xl p-6 shadow-sm border-l-4 border-purple-500"><div className="flex justify-between"><div><p className="text-gray-500 text-sm">Health Tips</p><p className="text-3xl font-bold text-purple-600">{patientStats.healthTips}</p></div><Star className="w-8 h-8 text-purple-500" /></div></div>
                </div>
                <div className="bg-gradient-to-r from-green-600 to-teal-600 rounded-2xl p-6 text-white"><div className="flex items-center gap-3 mb-3"><Shield className="w-6 h-6" /><h3 className="text-xl font-bold">Patient Dashboard</h3></div><p>Verify your medicines by scanning QR code and keep track of your verified medicines.</p><button onClick={() => setActiveTab("scan")} className="mt-4 bg-white text-green-700 px-4 py-2 rounded-lg font-medium">Scan Medicine →</button></div>
                <div className="bg-blue-50 rounded-2xl p-5 border border-blue-200"><h4 className="font-semibold text-blue-800 mb-2 flex items-center gap-2"><AlertCircle className="w-4 h-4" />Health Tips</h4><ul className="space-y-2 text-sm text-blue-700"><li>✓ Always verify medicines before taking them</li><li>✓ Check expiry date on every medicine package</li><li>✓ Report counterfeit medicines to TMDA</li><li>✓ Keep medicines in cool, dry place</li></ul></div>
              </div>
            ) : (
              <>
                <div className="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
                  <div className="bg-white rounded-2xl p-6 shadow-sm"><div className="flex justify-between items-start"><div><p className="text-gray-500 text-sm">Total Medicines</p><p className="text-3xl font-bold text-gray-800">{stats.total}</p></div><div className="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center"><Package className="w-6 h-6 text-blue-600" /></div></div></div>
                  <div className="bg-white rounded-2xl p-6 shadow-sm"><div className="flex justify-between items-start"><div><p className="text-gray-500 text-sm">Active Batches</p><p className="text-3xl font-bold text-green-600">{stats.active}</p></div><div className="w-12 h-12 bg-green-100 rounded-xl flex items-center justify-center"><CheckCircle className="w-6 h-6 text-green-600" /></div></div></div>
                  <div className="bg-white rounded-2xl p-6 shadow-sm"><div className="flex justify-between items-start"><div><p className="text-gray-500 text-sm">Verified Items</p><p className="text-3xl font-bold text-cyan-600">{stats.verified}</p></div><div className="w-12 h-12 bg-cyan-100 rounded-xl flex items-center justify-center"><Shield className="w-6 h-6 text-cyan-600" /></div></div></div>
                  <div className="bg-white rounded-2xl p-6 shadow-sm"><div className="flex justify-between items-start"><div><p className="text-gray-500 text-sm">Total Value</p><p className="text-3xl font-bold text-purple-600">{stats.value.toLocaleString()} TZS</p></div><div className="w-12 h-12 bg-purple-100 rounded-xl flex items-center justify-center"><Wallet className="w-6 h-6 text-purple-600" /></div></div></div>
                </div>
                <div className="grid grid-cols-1 lg:grid-cols-3 gap-6">
                  <div className="lg:col-span-2 bg-white rounded-2xl p-6 shadow-sm"><h3 className="font-semibold mb-4">Recent Activities</h3>{recentTransactions.length === 0 ? <div className="text-center py-8 text-gray-400">No recent transactions</div> : recentTransactions.map((tx, idx) => (<div key={idx} className="flex justify-between p-3 bg-gray-50 rounded-xl mb-2"><div><p className="font-medium">{tx.action}</p><p className="text-xs text-gray-400">Batch: {tx.batch}</p></div><div className="text-right"><p className="text-xs text-gray-400">{tx.time}</p></div></div>))}</div>
                  <div className="bg-gradient-to-r from-blue-600 to-cyan-600 rounded-2xl p-6 text-white"><h3 className="font-semibold mb-4 flex items-center gap-2"><Shield className="w-5 h-5" />Blockchain Status</h3><div className="space-y-2 text-sm"><div className="flex justify-between"><span>Network</span><span>Ethereum</span></div><div className="flex justify-between"><span>Status</span><span className="text-green-300">● Active</span></div><div className="flex justify-between"><span>Records</span><span>{medicines.length} on-chain</span></div></div></div>
                </div>
              </>
            )}
          </>
        )}

        {/* CREATE MEDICINE - Manufacturer only */}
        {activeTab === "create" && user?.role === "manufacturer" && (
          <div className="bg-white rounded-2xl shadow-sm p-8 max-w-2xl">
            <h2 className="text-xl font-bold mb-6">Create New Medicine</h2>
            <div className="space-y-4">
              <input type="text" placeholder="Medicine Name" value={medName} onChange={(e) => setMedName(e.target.value)} className="w-full p-3 border rounded-xl" />
              <input type="text" placeholder="Batch Number" value={medBatch} onChange={(e) => setMedBatch(e.target.value)} className="w-full p-3 border rounded-xl" />
              <input type="date" placeholder="Expiry Date" value={medExpiry} onChange={(e) => setMedExpiry(e.target.value)} className="w-full p-3 border rounded-xl" />
              <input type="number" placeholder="Price (TZS)" value={medPrice} onChange={(e) => setMedPrice(e.target.value)} className="w-full p-3 border rounded-xl" />
              <button onClick={createMedicine} className="w-full bg-blue-600 text-white py-3 rounded-xl font-semibold">Create on Blockchain</button>
            </div>
          </div>
        )}

        {/* VERIFY MEDICINE - Patient only with PRODUCTION QR SCANNER */}
        {activeTab === "scan" && user?.role === "patient" && (
          <div className="space-y-6">
            <div className="bg-white rounded-2xl shadow-sm p-8">
              <div className="flex items-center gap-3 mb-6">
                <div className="w-12 h-12 bg-green-100 rounded-xl flex items-center justify-center">
                  <QrCode className="w-6 h-6 text-green-600" />
                </div>
                <div>
                  <h2 className="text-xl font-bold">Verify Medicine</h2>
                  <p className="text-gray-500 text-sm">Scan QR code using camera or enter batch number manually</p>
                </div>
              </div>
              
              {/* Production QR Scanner */}
              <div className="mb-8">
                <div className="bg-gray-900 rounded-2xl p-4 text-center">
                  <div id="qr-reader" style={{ width: "100%", maxWidth: "400px", margin: "0 auto", minHeight: "300px" }}></div>
                  <div className="mt-4 flex gap-3 justify-center">
                    {!isScanning ? (
                      <button 
                        onClick={startScanner}
                        className="bg-green-600 text-white px-6 py-2 rounded-lg text-sm font-medium hover:bg-green-700 transition inline-flex items-center gap-2"
                      >
                        <Camera className="w-4 h-4" />
                        Start Camera
                      </button>
                    ) : (
                      <button 
                        onClick={stopScanner}
                        className="bg-red-600 text-white px-6 py-2 rounded-lg text-sm font-medium hover:bg-red-700 transition inline-flex items-center gap-2"
                      >
                        <StopCircle className="w-4 h-4" />
                        Stop Camera
                      </button>
                    )}
                  </div>
                </div>
                <p className="text-center text-xs text-gray-400 mt-3">Position QR code in front of camera to scan automatically</p>
              </div>
              
              {/* Manual Entry */}
              <div className="border-t pt-6">
                <label className="block text-sm font-medium text-gray-700 mb-2">Or Enter Batch Number Manually</label>
                <div className="flex gap-3">
                  <input 
                    type="text" 
                    placeholder="Example: BATCH-001" 
                    value={scanBatch} 
                    onChange={(e) => setScanBatch(e.target.value)} 
                    className="flex-1 p-3 border border-gray-200 rounded-xl focus:border-green-500 focus:ring-2 focus:ring-green-200 outline-none transition"
                  />
                  <button 
                    onClick={verifyMedicine} 
                    className="bg-gradient-to-r from-green-600 to-emerald-600 text-white px-8 py-3 rounded-xl font-semibold hover:shadow-lg transition-all"
