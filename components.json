          {user?.role === "admin" && (
            <button onClick={() => { setActiveTab("admin"); stopScanner(); }} className={`w-full flex items-center gap-3 px-3 py-2.5 rounded-xl transition-all ${activeTab === "admin" ? "bg-red-600/20 text-white" : "text-white/60 hover:text-white hover:bg-white/5"}`}>
