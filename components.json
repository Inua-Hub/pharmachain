                  <div className="bg-white rounded-2xl p-6 shadow-sm border-l-4 border-yellow-500"><p className="text-gray-500 text-sm">Pending</p><p className="text-3xl font-bold text-yellow-600">1,500,000 TZS</p></div>
                </div>
                <div className="bg-blue-50 rounded-2xl p-8 text-center border border-blue-200"><Shield className="w-16 h-16 text-blue-600 mx-auto mb-4" /><h3 className="text-xl font-bold text-gray-800">Admin Dashboard</h3><p className="text-gray-600 mt-2">Manage members, payments, and system settings from Admin Panel.</p></div>
              </div>
