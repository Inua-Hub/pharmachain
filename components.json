"use client";

import { useState, useEffect, useRef } from "react";
import { 
  LayoutDashboard, 
  Package, 
  Scan, 
  Truck, 
  LogOut,
  Shield,
  CheckCircle,
  AlertTriangle,
  QrCode,
  ArrowRight,
  User,
  Mail,
  Phone,
  Lock,
  Eye,
  EyeOff,
  X,
  Menu,
  ChevronRight,
  Plus,
  History,
  Wallet,
  Users,
  RefreshCw,
  Download,
  Edit,
  Trash2,
  DollarSign,
  Bell,
  Settings,
  Activity,
  Database,
  Server,
  Send,
  Ban,
  UserCheck,
  Calendar,
  Clock,
  Store,
  Search,
  Star,
  AlertCircle,
  Camera,
  StopCircle
} from "lucide-react";

export default function Home() {
  const [page, setPage] = useState<"home" | "dashboard">("home");
  const [user, setUser] = useState<any>(null);
  const [showLogin, setShowLogin] = useState(false);
  const [showRegister, setShowRegister] = useState(false);
  const [medicines, setMedicines] = useState<any[]>([]);
  const [verified, setVerified] = useState<number[]>([]);
  const [dispensed, setDispensed] = useState<any[]>([]);
  const [sidebarCollapsed, setSidebarCollapsed] = useState(false);
  const [showPassword, setShowPassword] = useState(false);
  const [showRegPassword, setShowRegPassword] = useState(false);
  const [allUsers, setAllUsers] = useState<any[]>([]);
  const [regularMembers, setRegularMembers] = useState<any[]>([]);
  const [adminStats, setAdminStats] = useState({ totalMembers: 0, manufacturers: 0, distributors: 0, pharmacies: 0, patients: 0 });
  const [isScanning, setIsScanning] = useState(false);
  const scannerRef = useRef<any>(null);

  // Login form
  const [loginEmail, setLoginEmail] = useState("");
  const [loginPassword, setLoginPassword] = useState("");

  // Register form
  const [regName, setRegName] = useState("");
  const [regEmail, setRegEmail] = useState("");
  const [regPhone, setRegPhone] = useState("");
  const [regPassword, setRegPassword] = useState("");
  const [regRole, setRegRole] = useState("patient");
  const [regConfirmPassword, setRegConfirmPassword] = useState("");

  // Medicine form
  const [medName, setMedName] = useState("");
  const [medBatch, setMedBatch] = useState("");
  const [medExpiry, setMedExpiry] = useState("");
  const [medPrice, setMedPrice] = useState("");
  const [scanBatch, setScanBatch] = useState("");
  const [verifyResult, setVerifyResult] = useState<any>(null);
  const [activeTab, setActiveTab] = useState("home");
  const [recentTransactions, setRecentTransactions] = useState<any[]>([]);
  const [showPaymentModal, setShowPaymentModal] = useState(false);
  const [showNotifyModal, setShowNotifyModal] = useState(false);
  const [selectedMember, setSelectedMember] = useState<any>(null);
  const [selectedMedicine, setSelectedMedicine] = useState<any>(null);
  const [notifySubject, setNotifySubject] = useState("");
  const [notifyMessage, setNotifyMessage] = useState("");
  const [notifyRole, setNotifyRole] = useState("all");
  const [searchTerm, setSearchTerm] = useState("");
  const [patientName, setPatientName] = useState("");
  const [patientId, setPatientId] = useState("");

  // Pharmacy dashboard stats
  const [pharmacyStats, setPharmacyStats] = useState({
    totalMedicines: 0,
    inStock: 0,
    dispensedToday: 0,
    expiringSoon: 0,
    totalValue: 0
  });

  // Patient dashboard stats
  const [patientStats, setPatientStats] = useState({
    verifiedCount: 0,
    lastVerified: "",
    healthTips: 0
  });

  // Start QR Scanner
  const startScanner = async () => {
    if (scannerRef.current) {
      try {
        await scannerRef.current.stop();
      } catch (e) {}
      scannerRef.current = null;
    }

    setIsScanning(true);

    try {
      const { Html5Qrcode } = await import("html5-qrcode");
      const scanner = new Html5Qrcode("qr-reader");
      scannerRef.current = scanner;

      await scanner.start(
        { facingMode: "environment" },
        {
          fps: 10,
          qrbox: { width: 250, height: 250 },
          aspectRatio: 1.0,
        },
        (decodedText: string) => {
          setScanBatch(decodedText);
          verifyMedicineWithBatch(decodedText);
          if (scannerRef.current) {
            scannerRef.current.stop().catch(() => {});
            scannerRef.current = null;
          }
          setIsScanning(false);
        },
        (errorMessage: string) => {
          // Continue scanning
        }
      );
    } catch (err) {
      console.error("Scanner error:", err);
      alert("Could not access camera. Please enter batch number manually.");
      setIsScanning(false);
    }
  };

  // Stop QR Scanner
  const stopScanner = async () => {
    if (scannerRef.current) {
      try {
        await scannerRef.current.stop();
      } catch (e) {}
      scannerRef.current = null;
    }
    setIsScanning(false);
  };

  // Verify medicine with batch number
  const verifyMedicineWithBatch = (batchNo: string) => {
    const found = medicines.find(m => m.batchNo === batchNo);
    if (found) {
      if (user?.role === "patient" && !verified.includes(found.id)) {
        const updated = [...verified, found.id];
        setVerified(updated);
        localStorage.setItem("verified", JSON.stringify(updated));
        
        setPatientStats({
          verifiedCount: updated.length,
          lastVerified: found.name,
          healthTips: 3
        });
      }
      setVerifyResult({ success: true, medicine: found });
    } else {
      setVerifyResult({ success: false });
    }
  };

  const verifyMedicine = () => {
    verifyMedicineWithBatch(scanBatch);
  };

  useEffect(() => {
    const existingUsers = localStorage.getItem("allUsers");
    
    if (!existingUsers) {
      const adminUser = {
        id: 999,
        name: "System Admin",
        email: "admin@pharmachain.com",
        password: "admin123",
        phone: "+255 888 123 456",
        role: "admin",
        status: "active",
        createdAt: new Date().toISOString()
      };
      localStorage.setItem("allUsers", JSON.stringify([adminUser]));
    }
    
    const users = JSON.parse(localStorage.getItem("allUsers") || "[]");
    const members = users.filter((u: any) => u.role !== "admin");
    
    setAllUsers(users);
    setRegularMembers(members);
    setAdminStats({
      totalMembers: members.length,
      manufacturers: members.filter((u: any) => u.role === "manufacturer").length,
      distributors: members.filter((u: any) => u.role === "distributor").length,
      pharmacies: members.filter((u: any) => u.role === "pharmacy").length,
      patients: members.filter((u: any) => u.role === "patient").length,
    });
    
    const savedMedicines = localStorage.getItem("medicines");
    if (savedMedicines) {
      const loadedMedicines = JSON.parse(savedMedicines);
      setMedicines(loadedMedicines);
      
      const expiring = loadedMedicines.filter((m: any) => {
        if (!m.expiryDate) return false;
        const daysLeft = (new Date(m.expiryDate).getTime() - new Date().getTime()) / (1000 * 3600 * 24);
        return daysLeft <= 30 && daysLeft > 0;
      }).length;
      
      setPharmacyStats({
        totalMedicines: loadedMedicines.length,
        inStock: loadedMedicines.filter((m: any) => m.status === "active").length,
        dispensedToday: 0,
        expiringSoon: expiring,
        totalValue: loadedMedicines.reduce((sum: number, m: any) => sum + (parseInt(m.price) || 0), 0)
      });
    }
    
    const savedVerified = localStorage.getItem("verified");
    if (savedVerified) {
      const loadedVerified = JSON.parse(savedVerified);
      setVerified(loadedVerified);
      
      const verifiedMedicines = medicines.filter(m => loadedVerified.includes(m.id));
      setPatientStats({
        verifiedCount: verifiedMedicines.length,
        lastVerified: verifiedMedicines.length > 0 ? verifiedMedicines[verifiedMedicines.length - 1]?.name : "None",
        healthTips: 3
      });
    }
    
    const savedDispensed = localStorage.getItem("dispensed");
    if (savedDispensed) setDispensed(JSON.parse(savedDispensed));
    
    const savedUser = localStorage.getItem("pharmaUser");
    if (savedUser) {
      const u = JSON.parse(savedUser);
      setUser(u);
      setPage("dashboard");
    }

    return () => {
      if (scannerRef.current) {
        scannerRef.current.stop().catch(() => {});
      }
    };
  }, []);

  const handleRegister = () => {
    if (!regName || !regEmail || !regPassword) {
      alert("Please fill all fields");
      return;
    }
    if (regPassword !== regConfirmPassword) {
      alert("Passwords do not match");
      return;
    }
    
    const existingUsers = JSON.parse(localStorage.getItem("allUsers") || "[]");
    
    if (existingUsers.find((u: any) => u.email === regEmail)) {
      alert("Email already registered. Please login.");
      return;
    }
    
    const newUser = { 
      id: Date.now(),
      name: regName, 
      email: regEmail, 
      phone: regPhone, 
      password: regPassword, 
      role: regRole,
      status: "active",
      createdAt: new Date().toISOString()
    };
    
    existingUsers.push(newUser);
    localStorage.setItem("allUsers", JSON.stringify(existingUsers));
    localStorage.setItem("pharmaUser", JSON.stringify(newUser));
    
    setShowRegister(false);
    alert("Registration successful! Please login.");
    setShowLogin(true);
  };

  const handleLogin = () => {
    const existingUsers = JSON.parse(localStorage.getItem("allUsers") || "[]");
    const foundUser = existingUsers.find((u: any) => u.email === loginEmail && u.password === loginPassword);
    
    if (!foundUser) {
      alert("Invalid email or password");
      return;
    }
    
    if (foundUser.status === "banned") {
      alert("Your account has been banned. Contact admin.");
      return;
    }
    
    setUser(foundUser);
    localStorage.setItem("pharmaUser", JSON.stringify(foundUser));
    setShowLogin(false);
    setPage("dashboard");
    
    const savedMedicines = localStorage.getItem("medicines");
    if (savedMedicines) setMedicines(JSON.parse(savedMedicines));
    
    const savedVerified = localStorage.getItem("verified");
    if (savedVerified) setVerified(JSON.parse(savedVerified));
  };

  const handleLogout = () => {
    setUser(null);
    setPage("home");
    setActiveTab("home");
    localStorage.removeItem("pharmaUser");
    stopScanner();
  };

  const createMedicine = () => {
    if (!medName || !medBatch) {
      alert("Please fill medicine name and batch");
      return;
    }
    const newMedicine = {
      id: Date.now(),
      name: medName,
      batchNo: medBatch,
      expiryDate: medExpiry,
      price: medPrice,
      manufacturer: user?.name,
      status: "active",
      createdAt: new Date().toISOString(),
      txHash: `0x${Math.random().toString(36).substring(2, 10)}...`
    };
    const updated = [...medicines, newMedicine];
    setMedicines(updated);
    localStorage.setItem("medicines", JSON.stringify(updated));
    
    setRecentTransactions([{
      id: Date.now(),
      action: `Created ${medName}`,
      batch: medBatch,
      time: new Date().toLocaleTimeString(),
      hash: newMedicine.txHash
    }, ...recentTransactions.slice(0, 4)]);
    
    alert(`✅ Medicine "${medName}" created on blockchain!`);
    setMedName("");
    setMedBatch("");
    setMedExpiry("");
    setMedPrice("");
  };

  const dispenseMedicine = () => {
    if (!selectedMedicine || !patientName) {
      alert("Please select medicine and enter patient name");
      return;
    }
    
    const dispenseRecord = {
      id: Date.now(),
      medicineId: selectedMedicine.id,
      medicineName: selectedMedicine.name,
      batchNo: selectedMedicine.batchNo,
      patientName: patientName,
      patientId: patientId || `PAT-${Math.random().toString(36).substring(2, 8).toUpperCase()}`,
      dispensedAt: new Date().toISOString(),
      price: selectedMedicine.price,
      pharmacist: user?.name,
      status: "dispensed"
    };
    
    const updatedDispensed = [...dispensed, dispenseRecord];
    setDispensed(updatedDispensed);
    localStorage.setItem("dispensed", JSON.stringify(updatedDispensed));
    
    const updatedMedicines = medicines.map(m => 
      m.id === selectedMedicine.id ? { ...m, status: "dispensed" } : m
    );
    setMedicines(updatedMedicines);
    localStorage.setItem("medicines", JSON.stringify(updatedMedicines));
    
    alert(`✅ ${selectedMedicine.name} dispensed to ${patientName}`);
    setSelectedMedicine(null);
    setPatientName("");
    setPatientId("");
    
    setPharmacyStats({
      ...pharmacyStats,
      inStock: updatedMedicines.filter(m => m.status === "active").length,
      dispensedToday: pharmacyStats.dispensedToday + 1
    });
  };

  const getMyMedicines = () => {
    if (user?.role === "manufacturer") return medicines.filter(m => m.manufacturer === user.name);
    if (user?.role === "pharmacy") return medicines.filter(m => m.status === "active");
    if (user?.role === "patient") return medicines.filter(m => verified.includes(m.id));
    return medicines;
  };

  const getFilteredMedicines = () => {
    let items = getMyMedicines();
    if (searchTerm) {
      items = items.filter(m => 
        m.name.toLowerCase().includes(searchTerm.toLowerCase()) ||
        m.batchNo.toLowerCase().includes(searchTerm.toLowerCase())
      );
    }
    return items;
  };

  const getStats = () => {
    const myMeds = getMyMedicines();
    return {
      total: myMeds.length,
      active: medicines.filter(m => m.status === "active").length,
      verified: verified.length,
      value: myMeds.reduce((sum, m) => sum + (parseInt(m.price) || 0), 0)
    };
  };

  const sendReminder = (member: any) => {
    alert(`📧 Payment reminder sent to ${member.email}`);
  };

  const markPaid = () => {
    alert(`✅ Payment recorded for ${selectedMember?.name}`);
    setShowPaymentModal(false);
    setSelectedMember(null);
  };

  const banUser = (member: any) => {
    if (confirm(`Ban ${member.name}?`)) {
      const all = JSON.parse(localStorage.getItem("allUsers") || "[]");
      const updated = all.map((u: any) => u.id === member.id ? { ...u, status: "banned" } : u);
      localStorage.setItem("allUsers", JSON.stringify(updated));
      alert(`⚠️ ${member.name} banned`);
      window.location.reload();
    }
  };

  const activateUser = (member: any) => {
    const all = JSON.parse(localStorage.getItem("allUsers") || "[]");
    const updated = all.map((u: any) => u.id === member.id ? { ...u, status: "active" } : u);
    localStorage.setItem("allUsers", JSON.stringify(updated));
    alert(`✅ ${member.name} activated`);
    window.location.reload();
  };

  const sendNotification = () => {
    let count = notifyRole === "all" ? regularMembers.length : regularMembers.filter((m: any) => m.role === notifyRole).length;
    alert(`✅ Notification sent to ${count} members\nSubject: ${notifySubject}`);
    setShowNotifyModal(false);
    setNotifySubject("");
    setNotifyMessage("");
  };

  const getAmount = (role: string) => {
    const map: any = { manufacturer: "2,500,000", distributor: "1,500,000", pharmacy: "500,000", patient: "0" };
    return map[role] || "0";
  };

  const getPlan = (role: string) => {
    const map: any = { manufacturer: "Enterprise", distributor: "Business", pharmacy: "Standard", patient: "Free" };
    return map[role] || "Basic";
  };

  const getExpiryStatus = (expiryDate: string) => {
    if (!expiryDate) return "N/A";
    const daysLeft = (new Date(expiryDate).getTime() - new Date().getTime()) / (1000 * 3600 * 24);
    if (daysLeft < 0) return "Expired";
    if (daysLeft < 30) return `Expires in ${Math.ceil(daysLeft)} days`;
    return "Good";
  };

  const getExpiryColor = (expiryDate: string) => {
    if (!expiryDate) return "text-gray-400";
    const daysLeft = (new Date(expiryDate).getTime() - new Date().getTime()) / (1000 * 3600 * 24);
    if (daysLeft < 0) return "text-red-600";
    if (daysLeft < 30) return "text-yellow-600";
    return "text-green-600";
  };

  if (page === "home") {
    return (
      <div className="min-h-screen bg-[#0a0e27]">
        <div className="fixed inset-0 overflow-hidden pointer-events-none">
          <div className="absolute top-20 left-10 w-72 h-72 bg-blue-500/20 rounded-full blur-3xl animate-pulse" />
          <div className="absolute bottom-20 right-10 w-96 h-96 bg-cyan-500/20 rounded-full blur-3xl animate-pulse delay-1000" />
        </div>

        <nav className="relative z-10 bg-white/5 backdrop-blur-xl border-b border-white/10">
          <div className="container mx-auto px-6 py-4 flex justify-between items-center">
            <div className="flex items-center gap-2">
              <div className="w-10 h-10 bg-gradient-to-r from-blue-500 to-cyan-500 rounded-xl flex items-center justify-center">
                <Package className="w-5 h-5 text-white" />
              </div>
              <span className="text-xl font-bold text-white">Pharma<span className="text-cyan-400">Chain</span></span>
            </div>
            <div className="flex items-center gap-4">
              <button onClick={() => setShowLogin(true)} className="text-white/80 hover:text-white px-5 py-2 transition">Sign In</button>
              <button onClick={() => setShowRegister(true)} className="bg-gradient-to-r from-blue-500 to-cyan-500 text-white px-6 py-2 rounded-xl font-semibold">Get Started <ArrowRight className="inline ml-2 w-4 h-4" /></button>
            </div>
          </div>
        </nav>

        <div className="relative z-10 container mx-auto px-6 py-20 text-center">
          <div className="inline-flex items-center gap-2 bg-white/10 backdrop-blur rounded-full px-4 py-1.5 mb-6">
            <div className="w-2 h-2 bg-green-400 rounded-full animate-pulse" />
            <span className="text-sm text-white/80">Blockchain Network Active</span>
          </div>
          <h1 className="text-6xl font-bold text-white mb-6">Secure Pharmaceutical<br /><span className="bg-gradient-to-r from-blue-400 to-cyan-400 bg-clip-text text-transparent">Supply Chain</span></h1>
          <p className="text-xl text-white/60 max-w-2xl mx-auto mb-10">Track medicines from manufacturer to patient with immutable blockchain records.</p>
          <button onClick={() => setShowRegister(true)} className="bg-gradient-to-r from-blue-500 to-cyan-500 text-white px-8 py-3.5 rounded-xl font-semibold text-lg">Start Tracking Now</button>
        </div>

        {/* Login Modal */}
        {showLogin && (
          <div className="fixed inset-0 bg-black/80 backdrop-blur-sm flex items-center justify-center z-50 p-4">
            <div className="bg-white rounded-2xl w-full max-w-md overflow-hidden">
              <div className="bg-gradient-to-r from-blue-600 to-cyan-600 p-6 text-white">
                <div className="flex justify-between items-center">
                  <div className="flex items-center gap-2">
                    <Package className="w-5 h-5" />
                    <span className="font-bold">PharmaChain</span>
                  </div>
                  <button onClick={() => setShowLogin(false)}><X className="w-5 h-5" /></button>
                </div>
                <h2 className="text-2xl font-bold mt-6">Welcome Back</h2>
              </div>
              <div className="p-6">
                <div className="space-y-4">
                  <input type="email" placeholder="Email" value={loginEmail} onChange={(e) => setLoginEmail(e.target.value)} className="w-full p-3 border rounded-xl" />
                  <input type={showPassword ? "text" : "password"} placeholder="Password" value={loginPassword} onChange={(e) => setLoginPassword(e.target.value)} className="w-full p-3 border rounded-xl" />
                  <button onClick={handleLogin} className="w-full bg-blue-600 text-white py-3 rounded-xl font-semibold">Sign In</button>
                  <button onClick={() => { setShowLogin(false); setShowRegister(true); }} className="w-full text-blue-600">Create Account</button>
                </div>
              </div>
            </div>
          </div>
        )}

        {/* Register Modal */}
        {showRegister && (
          <div className="fixed inset-0 bg-black/80 backdrop-blur-sm flex items-center justify-center z-50 p-4 overflow-y-auto">
            <div className="bg-white rounded-2xl w-full max-w-md overflow-hidden my-8">
              <div className="bg-gradient-to-r from-blue-600 to-cyan-600 p-6 text-white">
                <div className="flex justify-between">
                  <div className="flex items-center gap-2"><Package className="w-5 h-5" /><span className="font-bold">PharmaChain</span></div>
                  <button onClick={() => setShowRegister(false)}><X className="w-5 h-5" /></button>
                </div>
                <h2 className="text-2xl font-bold mt-6">Create Account</h2>
              </div>
              <div className="p-6">
                <div className="space-y-3">
                  <input type="text" placeholder="Full Name" value={regName} onChange={(e) => setRegName(e.target.value)} className="w-full p-3 border rounded-xl" />
                  <input type="email" placeholder="Email" value={regEmail} onChange={(e) => setRegEmail(e.target.value)} className="w-full p-3 border rounded-xl" />
                  <input type="tel" placeholder="Phone" value={regPhone} onChange={(e) => setRegPhone(e.target.value)} className="w-full p-3 border rounded-xl" />
                  <input type={showRegPassword ? "text" : "password"} placeholder="Password" value={regPassword} onChange={(e) => setRegPassword(e.target.value)} className="w-full p-3 border rounded-xl" />
                  <input type="password" placeholder="Confirm Password" value={regConfirmPassword} onChange={(e) => setRegConfirmPassword(e.target.value)} className="w-full p-3 border rounded-xl" />
                  <select value={regRole} onChange={(e) => setRegRole(e.target.value)} className="w-full p-3 border rounded-xl">
                    <option value="manufacturer">🏭 Manufacturer</option>
                    <option value="distributor">🚚 Distributor</option>
                    <option value="pharmacy">💊 Pharmacy</option>
                    <option value="patient">👤 Patient</option>
                  </select>
                  <button onClick={handleRegister} className="w-full bg-blue-600 text-white py-3 rounded-xl font-semibold">Register</button>
                </div>
              </div>
            </div>
          </div>
        )}
      </div>
    );
  }

  const stats = getStats();
  const myMedicines = getFilteredMedicines();

  return (
    <div className="min-h-screen bg-[#f0f2f8]">
      {/* Sidebar */}
      <aside className={`fixed left-0 top-0 h-full bg-gradient-to-b from-[#0a0e27] to-[#131b3e] transition-all duration-300 z-20 ${sidebarCollapsed ? "w-20" : "w-72"}`}>
        <div className="p-5 flex items-center justify-between border-b border-white/10">
          <div className="flex items-center gap-2">
            <div className="w-9 h-9 bg-gradient-to-r from-blue-500 to-cyan-500 rounded-xl flex items-center justify-center">
              <Package className="w-4 h-4 text-white" />
            </div>
            {!sidebarCollapsed && <span className="text-white font-bold">Pharma<span className="text-cyan-400">Chain</span></span>}
          </div>
          <button onClick={() => setSidebarCollapsed(!sidebarCollapsed)} className="text-white/50 hover:text-white">
            <Menu className="w-5 h-5" />
          </button>
        </div>

        <nav className="p-4 space-y-1">
          <button onClick={() => { setActiveTab("home"); stopScanner(); }} className={`w-full flex items-center gap-3 px-3 py-2.5 rounded-xl transition-all ${activeTab === "home" ? "bg-white/10 text-white" : "text-white/60 hover:text-white hover:bg-white/5"}`}>
            <LayoutDashboard className="w-5 h-5" />
            {!sidebarCollapsed && <span className="text-sm">Dashboard</span>}
          </button>
          
          {user?.role === "manufacturer" && (
            <button onClick={() => { setActiveTab("create"); stopScanner(); }} className={`w-full flex items-center gap-3 px-3 py-2.5 rounded-xl transition-all ${activeTab === "create" ? "bg-white/10 text-white" : "text-white/60 hover:text-white hover:bg-white/5"}`}>
              <Plus className="w-5 h-5" />
              {!sidebarCollapsed && <span className="text-sm">Create Medicine</span>}
            </button>
          )}
          
          {user?.role === "patient" && (
            <button onClick={() => { setActiveTab("scan"); setVerifyResult(null); stopScanner(); }} className={`w-full flex items-center gap-3 px-3 py-2.5 rounded-xl transition-all ${activeTab === "scan" ? "bg-white/10 text-white" : "text-white/60 hover:text-white hover:bg-white/5"}`}>
              <Scan className="w-5 h-5" />
